{
  "schema_version": 2,
  "id": "resource_constrained_free_first_clear_v2",
  "description": "Deterministic free-account growth fixture shared by campaign front-line audit and runtime calibration probes. Weapon purchases and loadouts are matchup-aware from v2 onward.",
  "assumptions": {
    "difficulty": "normal",
    "first_clear_only": true,
    "stars_per_clear": 2,
    "challenge_rewards": false,
    "repeat_farming": false,
    "premium_items": false
  },
  "runtime_probe": {
    "fixed_card_seeds": [1103, 2207, 3301],
    "calibration_levels": [3, 8, 13, 30, 40, 55, 62, 75, 84, 95]
  },
  "initial_account": {
    "gold": 0,
    "xp": 0,
    "stars": 0,
    "owned": {
      "character": ["vanguard"],
      "weapon": ["weapon_autocannon"],
      "armor": [],
      "chip": [],
      "pet": []
    },
    "levels": {"vanguard": 1, "weapon_autocannon": 1},
    "skills": {},
    "signature_level": 0
  },
  "active_weapon_strategy": "matchup_aware_v2",
  "weapon_strategies": {
    "legacy_capacity_v1": {
      "purchase_mode": "fixed_order",
      "purchase_order": [
        {"slot": "armor", "item_id": "armor_kevlar"},
        {"slot": "chip", "item_id": "chip_attack"},
        {"slot": "pet", "item_id": "pet_turret_drone"},
        {"slot": "weapon", "item_id": "weapon_scattergun"}
      ],
      "selection": {
        "method": "weighted_capacity",
        "candidates": ["weapon_autocannon", "weapon_scattergun"],
        "boss_capacity_weight_if_present": 0.42,
        "boss_capacity_weight_otherwise": 0.1
      }
    },
    "matchup_aware_v2": {
      "purchase_mode": "next_chapter_modal_weakness",
      "non_weapon_purchase_order": [
        {"slot": "armor", "item_id": "armor_kevlar"},
        {"slot": "chip", "item_id": "chip_attack"},
        {"slot": "pet", "item_id": "pet_turret_drone"}
      ],
      "star_weapon_pool": {
        "source": "free_star_weapons",
        "minimum_star_cost": 1,
        "maximum_star_cost": 999,
        "chapter_reference": "next_chapter",
        "final_chapter_fallback": "current_chapter",
        "weakness_rule": "chapter_primary_weakness_mode",
        "tie_break": "first_authored_level_then_unlock_cost_then_weapon_order",
        "reserve_stars_for_next_matching_weapon": true
      },
      "selection": {
        "method": "power_for_build",
        "candidates": "all_owned_weapons",
        "tie_break": "weapon_data_order"
      },
      "gold_upgrade": {
        "priority": "next_level_equipped_weapon",
        "same_weapon_priority_upgrades_per_clear": 1,
        "switch_catch_up_max_gold_ratio": 0.4,
        "switch_catch_up_level_ceiling": "current_equipped_weapon_level",
        "after_priority": "balanced_existing_weights"
      }
    }
  },
  "gold_upgrade_weights": {
    "character": 1.0,
    "weapon": 0.9,
    "weapon_autocannon": 1.0,
    "weapon_scattergun": 0.82,
    "armor": 0.82,
    "chip": 0.92,
    "pet": 0.74
  },
  "xp_upgrade_order": [
    "skill_multishot",
    "skill_pierce",
    "skill_homing",
    "skill_barrier",
    "skill_salvo",
    "skill_charge_shot",
    "signature",
    "skill_slow_field",
    "skill_split_shot",
    "skill_critical",
    "skill_ricochet"
  ],
  "audit_outputs": {
    "weapon_strategy_comparison": "design/audits/campaign_progression_weapon_strategy_v2.csv"
  }
}
